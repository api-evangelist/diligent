          "name": "Submit alert for remediation (Beta)",
          "request": {
            "name": "Submit alert for remediation (Beta)",
            "description": {
              "content": "Submit an externally-screened alert for AI-powered remediation. For customers who perform name screening themselves and want Diligent's AI to resolve the hits.\n\nProcessing is asynchronous — use [Get Alert](/api-reference/name-screening/get-alert) to retrieve results.\n\nSee the [Remediation API Guide](/guides/name-screening/remediation-api) for recommended field labels and detailed examples.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "name-screenings",
                "alerts",
                "remediate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"<string>\",\n  \"input\": [\n    {\n      \"label\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"hits\": [\n    {\n      \"reference\": \"<string>\",\n      \"categories\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"fields\": [\n        {\n          \"label\": \"<string>\",\n          \"value\": \"<string>\"\n        }\n      ],\n      \"profile_reference\": \"<string>\"\n    }\n  ],\n  \"alt_reference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
