{
  "opencollection": "1.0.0",
  "info": {
    "name": "Diligent CDD Webhooks API",
    "version": "1.6.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registered webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.godiligent.ai/webhooks"
          },
          "docs": "List registered webhooks"
        },
        {
          "info": {
            "name": "Register or update webhook configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.godiligent.ai/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register or update webhook configuration"
        },
        {
          "info": {
            "name": "List recent webhook deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.godiligent.ai/webhooks/:webhook_id/events",
            "params": [
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "Webhook ID to filter deliveries."
              }
            ]
          },
          "docs": "List recent webhook deliveries"
        },
        {
          "info": {
            "name": "Redeliver a webhook event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.godiligent.ai/webhooks/:webhook_id/events/:event_id/redeliver",
            "params": [
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "Webhook ID for the event to redeliver."
              },
              {
                "name": "event_id",
                "value": "",
                "type": "path",
                "description": "Event ID of the webhook to redeliver."
              }
            ]
          },
          "docs": "Redeliver a webhook event"
        }
      ]
    }
  ],
  "bundled": true
}